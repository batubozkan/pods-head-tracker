# pods-head-tracker configuration.
#
# Copy this file to the Pi as /etc/pods-head-tracker.conf and edit it:
#   sudo install -m 644 pods-head-tracker.conf.example /etc/pods-head-tracker.conf
#   sudo nano /etc/pods-head-tracker.conf
# The systemd service reads it on start; apply changes with:
#   sudo systemctl restart pods-head-tracker

# Your AirPods' Bluetooth *Classic* MAC -- the address you paired in
# bluetoothctl (not the LE address).
AIRPODS_MAC=XX:XX:XX:XX:XX:XX

# How tracking data reaches the PC: udp (Wi-Fi), serial (USB cable), or both.
TRANSPORT=udp

# --- udp transport (OpenTrack input: "FreePIE UDP receiver") ---
# Your PC's LAN IP and OpenTrack's listen port.
UDP_HOST=192.0.2.10
UDP_PORT=4242

# --- serial transport (OpenTrack input: "Hatire Arduino") ---
# USB gadget serial device, created by setup-usb-serial.sh. Leave as-is.
SERIAL_DEV=/dev/ttyGS0

# --- USB audio (optional; installed by setup-usb-audio.sh) ---
# The audio forwarder reuses AIRPODS_MAC above -- nothing extra is required.
# 0 = head tracking only: the audio services stay installed but idle.
# Apply with: sudo systemctl restart pods-usb-audio
#AUDIO_ENABLE=1
# Loop latency in milliseconds: lower = snappier audio, higher = fewer
# dropouts. 50 is the safe default; 20 tested clean on a Pi Zero 2 W with
# tracking active. Apply with: sudo systemctl restart pods-usb-audio
#AUDIO_LATENCY_MS=50

# The buds' Bluetooth volume ceiling, 0-127. Day-to-day loudness is the
# normal Windows volume slider; raise this only if audio feels capped.
#AUDIO_VOLUME=70

# Re-zero the neutral ("facing forward") pose every N seconds (0 = only when
# the connection opens; see the on-demand re-centering below).
RECALIBRATE_SECS=0

# --- on-demand re-centering (no restart needed) ---
# On the serial transport the bridge re-centers by itself every time the
# PC (re)starts reading the COM port -- i.e. every time you press Start in
# OpenTrack. 0 = off. (UDP can't detect this: FreePIE is receive-only.)
#RECENTER_ON_START=1
# Re-center any time, on any transport, with:
#   sudo systemctl kill --signal=SIGUSR1 pods-head-tracker
# OpenTrack can also send the token below over the COM port (Hatire
# dialog: put it in "Reset command" for the Reset button, or type it in
# the Send box). Matched as raw bytes in the serial stream; empty = off.
#RECENTER_CMD=RECENTER

# 1 = log every sample (noisy; debugging only).
VERBOSE=0
